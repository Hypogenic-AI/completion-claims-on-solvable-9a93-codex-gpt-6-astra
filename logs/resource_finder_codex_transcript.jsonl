{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/usr/bin/bash -lc \"pwd\n.venv/bin/python - <<'PY'\nfrom pathlib import Path\nimport json\np=Path('evidence/literature_downloads.json');rows=json.loads(p.read_text())\nfor r in rows:\n if r['search_index']==4:r.update(status='excluded_withdrawn',exclusion_reason='Author-withdrawn on arXiv; v2 and v3 marked withdrawn. Verified abstract page saved as evidence/hcrc_access.html. No substantive result used.')\np.write_text(json.dumps(rows,indent=2))\np=Path('literature_review.md');s=p.read_text();s=s.replace('Twenty-two public PDFs were obtained; HCRC returned 404, while TRACE and the coding DriftBench paper did not initially resolve to a public PDF. Four additional unique primary/background papers bring the archive to **26 papers**.','Twenty-three public PDFs were obtained, including TRACE recovered through its author website. HCRC was verified as author-withdrawn and excluded; the coding DriftBench paper remained unresolved after retries. Four additional unique primary/background papers bring the archive to **27 papers**.')\np.write_text(s)\nPY\ncat > scripts/download_papers.py <<'PY'\n\\\"\\\"\\\"Recreate the validated paper archive from its recorded primary-source URLs.\\\"\\\"\\\"\nfrom pathlib import Path\nimport requests,json,hashlib\nfrom pypdf import PdfReader\nROOT=Path(__file__).resolve().parents[1];assert Path.cwd()==ROOT and (ROOT/'.git').exists()\nrows=json.loads(Path('evidence/papers_manifest.json').read_text())\nfor row in rows:\n    path=Path(row['file']);expected=row.get('sha256')\n    if path.exists() and (not expected or hashlib.sha256(path.read_bytes()).hexdigest()==expected):continue\n    url=row.get('download_url') or 'https://arxiv.org/pdf/'+row['arxiv_id']\n    r=requests.get(url,timeout=90);r.raise_for_status();assert r.content.startswith(b'%PDF')\n    if expected and hashlib.sha256(r.content).hexdigest()\"'!=expected:\n        raise ValueError(f'\"'Upstream bytes changed for {path}; inspect version rather than silently accepting.')\n    path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(r.content);PdfReader(path)\nprint(f'{len(rows)} PDFs available and checked against recorded hashes when present.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
